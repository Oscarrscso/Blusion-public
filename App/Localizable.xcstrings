        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds missing items without deleting anything. Import puts your watchlist in Library and marks watched items. Send shares saved titles and watched marks with Trakt. Only titles with IMDb IDs can sync; playback positions stay on this device."
          }
        }
      }
    },
