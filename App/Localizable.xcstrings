    "Dolby Vision": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolby Vision"
          }
        }
      }
    },
    "Dolby Vision off plays the HDR10 picture underneath instead, for a release whose Dolby Vision looks wrong; it applies to MKV files (AetherEngine and the advanced player), and profile 5 always keeps its Dolby Vision. Fit keeps the full original picture; Fill crops centrally without stretching. Tone mapping, HDR and deinterlacing apply in the advanced player; the system handles them for MP4 and HLS. AI super resolution uses this device's machine-learning video scaler for SDR video below the screen's resolution, where the chip supports it, and a sharp conventional scaler otherwise.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolby Vision off plays the HDR10 picture underneath instead, for a release whose Dolby Vision looks wrong; it applies to MKV files (AetherEngine and the advanced player), and profile 5 always keeps its Dolby Vision. Fit keeps the full original picture; Fill crops centrally without stretching. Tone mapping, HDR and deinterlacing apply in the advanced player; the system handles them for MP4 and HLS. AI super resolution uses this device's machine-learning video scaler for SDR video below the screen's resolution, where the chip supports it, and a sharp conventional scaler otherwise."
          }
        }
      }
    },
